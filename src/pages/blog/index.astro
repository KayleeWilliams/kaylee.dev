---
import { getImage } from "astro:assets";
import inthLogo from "@/src/assets/inth.png";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import Icon from "@/src/components/Icon.astro";
import { getBlogListing } from "@/lib/get-blog-posts";
import { pageSeo } from "@/lib/seo";
import { withUtm } from "@/lib/utils/utm";

export const prerender = true;

const posts = await getBlogListing();
// 2x the 16px it renders at, so the mark stays crisp on retina screens.
const inthIcon = await getImage({
  src: inthLogo,
  width: 32,
  height: 32,
  format: "webp",
  quality: 90,
});
const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<BaseLayout title={pageSeo.blog.title} description={pageSeo.blog.description}>
  <header class="space-y-2">
    <h2 class="font-bold text-3xl tracking-tight">Blog</h2>
    <p class="max-w-prose text-muted-foreground">
      Notes on compliance, developer tools, and the small decisions that make software
      hold together.
    </p>
  </header>

  {
    posts.length > 0 ? (
      <ol class="divide-y divide-border" aria-label="Blog posts">
        {posts.map((post) => (
          <li class="py-5 first:pt-0">
            <article class="flex flex-col gap-2">
                <div class="flex items-baseline justify-between gap-4">
                  <a
                    class="group font-semibold text-foreground text-lg transition-colors duration-150 hover:text-primary"
                    href={post.source ? withUtm(post.href, "blog") : post.href}
                    rel={post.source ? "noopener noreferrer" : undefined}
                    target={post.source ? "_blank" : undefined}
                  >
                    <span class="group-hover:underline">{post.title}</span>
                    {post.source ? (
                      <Icon
                        class="ml-1 inline size-4 align-[-0.125em] text-muted-foreground"
                        name="external-link"
                      />
                    ) : null}
                  </a>
                  <time
                    class="shrink-0 text-muted-foreground text-sm tabular-nums"
                    datetime={post.publishedAt.toISOString()}
                  >
                    {dateFormat.format(post.publishedAt)}
                  </time>
                </div>
                <p class="max-w-prose text-muted-foreground text-sm">
                  {post.description}
                </p>
                {post.source ? (
                  <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <img
                      alt=""
                      class="size-4 rounded-sm"
                      decoding="async"
                      height="16"
                      loading="lazy"
                      src={inthIcon.src}
                      width="16"
                    />
                    {post.source}
                  </p>
                ) : post.tags.length > 0 ? (
                  <ul
                    class="flex flex-wrap gap-x-3 gap-y-1 text-muted-foreground text-xs"
                    aria-label="Topics"
                  >
                    {post.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                ) : null}
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <div class="rounded-lg border border-dashed border-border px-6 py-10 text-center">
        <p class="font-semibold">Nothing published yet.</p>
        <p class="mt-1 text-muted-foreground text-sm">The drafts are behaving themselves.</p>
      </div>
    )
  }
</BaseLayout>
