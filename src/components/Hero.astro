---
import { fetchNpmDownloads } from "@/lib/get-npm-downloads";
import { getSiteContent } from "@/lib/get-site-content";
import { fetchStars } from "@/lib/get-stars";
import { formatDownloads } from "@/lib/utils/format-downloads";
import { withUtm } from "@/lib/utils/utm";
import Card from "./Card.astro";
import CardContent from "./CardContent.astro";
import Icon from "./Icon.astro";

type HeroFrontmatter = {
  title?: string;
  description?: string;
  github?: string;
  npmPackage?: string;
  projectUrl?: string;
  statsUrl?: string;
  docsUrl?: string;
};

const hero = await getSiteContent<HeroFrontmatter>("hero");
const [stars, downloads] =
  hero?.github && hero.npmPackage
    ? await Promise.all([
        fetchStars(hero.github),
        fetchNpmDownloads(hero.npmPackage),
      ])
    : [undefined, undefined];
---

{
  hero?.projectUrl && hero.github && hero.npmPackage ? (
    <Card class="border-primary/25 bg-linear-to-br from-primary/6 to-card">
      <CardContent class="pt-6">
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1">
            <h2 class="font-bold text-lg text-primary md:text-xl">
              {hero.title ?? "c15t"}
            </h2>
            <p class="text-foreground text-sm md:text-base">{hero.description}</p>
          </div>

          {(stars || downloads) && (
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              {stars && (
                <div class="flex items-center gap-2">
                  <Icon class="size-5 text-yellow-500" name="star" />
                  <span class="font-semibold text-foreground">
                    {stars.toLocaleString()}+ stars
                  </span>
                </div>
              )}
              {downloads && (
                <a
                  class="group flex items-center gap-2"
                  href={hero.statsUrl ? withUtm(hero.statsUrl, "hero", "view-stats") : undefined}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <Icon class="size-5 text-muted-foreground" name="download" />
                  <span class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-[text-decoration-color] duration-150 group-hover:decoration-primary">
                    {formatDownloads(downloads)}+ monthly downloads
                  </span>
                </a>
              )}
            </div>
          )}

          <div class="flex flex-wrap gap-3">
            <a
              class="inline-flex items-center gap-1.5 rounded-md bg-primary px-4 py-2 font-medium text-primary-foreground text-sm transition-[background-color] duration-150 ease-out hover:bg-primary-hover active:scale-[0.98]"
              href={withUtm(hero.projectUrl, "hero", "view-project")}
              rel="noopener noreferrer"
              target="_blank"
            >
              View project
              <Icon class="size-4" name="external-link" />
            </a>
            {hero.docsUrl && (
              <a
                class="inline-flex items-center gap-1.5 rounded-md border border-primary/30 bg-card px-4 py-2 font-medium text-primary text-sm transition-[background-color,border-color] duration-150 ease-out hover:border-primary/50 hover:bg-primary/10 active:scale-[0.98]"
                href={withUtm(hero.docsUrl, "hero", "read-docs")}
                rel="noopener noreferrer"
                target="_blank"
              >
                Read docs
                <Icon class="size-4" name="external-link" />
              </a>
            )}
          </div>
        </div>
      </CardContent>
    </Card>
  ) : null
}
